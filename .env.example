# ───────────────────────────────────────────────────────────────────────
# Vaskebooking — environment template
# Copy this file to .env.local for local dev. Set the same vars in
# Vercel → Project Settings → Environment Variables for production.
# ───────────────────────────────────────────────────────────────────────

# Neon Postgres connection string (pooled URL — required for transactions
# via the WebSocket Pool driver in db/index.ts).
# Get it from: https://console.neon.tech → your project → Connection Details
# → "Pooled connection". Make sure ?sslmode=require is on it.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/vaskebooking?sslmode=require

# Shared building passcode. Anyone in the building enters this once when
# picking their apartment in /onboarding. Pick something simple your
# neighbors can remember (e.g. the building number).
BUILDING_PASSCODE=4242

# Random secret used to sign the device_id JWT cookie.
# Generate with:    openssl rand -hex 32
COOKIE_SECRET=replace-with-32-byte-random-hex

# VAPID keys for Web Push. Generate ONCE with:
#   pnpm dlx web-push generate-vapid-keys
# Use the same pair across all environments. The public key is bundled
# into the client; only the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact for push gateway operators (Apple/Mozilla/Google) to reach you
# if your app misbehaves. Must be a mailto: URL.
VAPID_CONTACT=mailto:admin@example.com

# Bearer secret for the /api/cron/* routes. Vercel Cron auto-injects this
# header; set the same value in Vercel env. Generate with:
#   openssl rand -hex 24
CRON_SECRET=replace-with-random
